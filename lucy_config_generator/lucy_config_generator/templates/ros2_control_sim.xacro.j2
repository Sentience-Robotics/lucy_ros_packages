<?xml version="1.0"?>
<!-- Generated by lucy_config_generator (simulation_only) — do not edit. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="inmoov" version="1.0">
  <xacro:arg name="use_gazebo_sim" default="false" />

  <ros2_control name="LucyHardwareSim" type="system">
      <hardware>
          <xacro:if value="$(arg use_gazebo_sim)">
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
          </xacro:if>
          <xacro:unless value="$(arg use_gazebo_sim)">
            <plugin>mock_components/GenericSystem</plugin>
          </xacro:unless>
      </hardware>
{% for j in joints %}
      <joint name="{{ j.urdf_joint }}">
          <param name="virtual_pin">{{ j.virtual_pin }}</param>
          <param name="servo_type">{{ j.servo_type | replace('"', '') }}</param>
          <param name="offset_deg">{{ j.offset_deg }}</param>
          <param name="direction">{{ j.direction }}</param>
          <param name="scale">{{ j.scale }}</param>
          <param name="servo_min_deg">{{ j.servo_min_deg }}</param>
          <param name="servo_max_deg">{{ j.servo_max_deg }}</param>
          <param name="servo_default_deg">{{ j.servo_default_deg }}</param>
          <command_interface name="position" />
          <state_interface name="position" />
      </joint>
{% endfor %}
  </ros2_control>

</robot>
