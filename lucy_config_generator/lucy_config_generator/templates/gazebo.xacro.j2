<?xml version="1.0"?>
<!-- Generated by lucy_config_generator — do not edit. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="inmoov" version="1.0">
  <xacro:arg name="use_mock_hardware" default="false" />

  {% for block in blocks %}
  <ros2_control name="{{ block.hardware_name }}" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    {% for j in block.joints %}
    <joint name="{{ j.urdf_joint }}">
      <param name="virtual_pin">{{ j.virtual_pin }}</param>
      <param name="servo_type">{{ j.servo_type | replace('"', '') }}</param>
      <param name="offset_deg">{{ j.offset_deg }}</param>
      <param name="direction">{{ j.direction }}</param>
      <param name="scale">{{ j.scale }}</param>
      <param name="servo_min_deg">{{ j.servo_min_deg }}</param>
      <param name="servo_max_deg">{{ j.servo_max_deg }}</param>
      <param name="servo_default_deg">{{ j.servo_default_deg }}</param>
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    {% endfor %}
  </ros2_control>
  {% endfor %}

  {% for camera in cameras %}
  <gazebo reference="{{ camera.link }}">
    <sensor type="camera">

    </sensor>
    <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>0.0</updateRate>
      <cameraName>robot/camera</cameraName>
      <imageTopicName>{{ camera.topic }}</imageTopicName>
    </plugin>
  </gazebo>
  {% endfor %}

</robot>
